# Server-only. Never prefix with NEXT_PUBLIC_.
PERMITSTACK_API_KEY=pk_your_key_here
# Optional override
# PERMITSTACK_BASE_URL=https://api.permit-stack.com
# POLK_ACCELA_ENABLED=false
# POLK_PA_ENABLED=false
# City of Davenport iWorQ. Search is invisible reCAPTCHA v2; detail pages are public.
# Leave the key unset to skip city search and still show other sources.
# DAVENPORT_IWORQ_ENABLED=false
# DAVENPORT_CAPTCHA_PROVIDER=2captcha
# DAVENPORT_CAPTCHA_API_KEY=
# Set DAVENPORT_CAPTCHA_PROVIDER=anticaptcha to use anti-captcha.com instead of 2captcha.
