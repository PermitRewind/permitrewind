# Server-only. Never prefix with NEXT_PUBLIC_.
PERMITSTACK_API_KEY=pk_your_key_here
# Optional override
# PERMITSTACK_BASE_URL=https://api.permit-stack.com
# POLK_ACCELA_ENABLED=false
# POLK_PA_ENABLED=false
# City of Davenport iWorQ. Address search reads data/davenport-harvest.json first
# and does not need a captcha. Addresses missing from the cache use invisible
# reCAPTCHA v2 when a solver key is set. Detail pages are public.
# DAVENPORT_CAPTCHA_* is optional once the address is in the harvest cache.
# DAVENPORT_IWORQ_ENABLED=false
# DAVENPORT_CAPTCHA_PROVIDER=2captcha
# DAVENPORT_CAPTCHA_API_KEY=
# Set DAVENPORT_CAPTCHA_PROVIDER=anticaptcha to use anti-captcha.com instead of 2captcha.
# Google Street View. Server-only. Never NEXT_PUBLIC_ and never a real key in git.
# Address results call /api/streetview, which checks the Metadata API first (free).
# A Static image is requested only when metadata status is OK and counts toward
# the 10,000 free images per month. Leave this empty to show "No street view available".
GOOGLE_STREET_VIEW_API_KEY=
